# Copy to .env and fill in what you need. `npm start` reads it if it is there
# and starts without it if it is not, so a fresh checkout still runs and the
# tests never depend on it.
#
# .env is ignored by git. Nothing here belongs in the repository.

# Left alone, both listeners bind 127.0.0.1 and only clients on this machine can
# connect. Letting another machine in takes the three lines below together:
# where the web service and the game socket bind, the address handed to clients
# during service discovery, and the acknowledgement that both ports carry
# player tokens in cleartext — without that last one, set to exactly 1, the
# server refuses to start on anything but loopback.
#
# Getting the second wrong is the usual first failure: the server starts and
# looks healthy, the client is told to connect to 127.0.0.1, tries to reach
# itself, and finds nothing. It has to be this machine's address as the other
# players reach it, never 0.0.0.0.
# ODS_HOST=0.0.0.0
# ODS_PUBLIC_HOST=192.168.1.10
# ODS_ALLOW_INSECURE_REMOTE=1
# ODS_PORT=8080
# ODS_SOCKET_PORT=7198

# What clients are told, where it differs from what is bound: a router that
# forwards another public port to either listener, or a tunnel that gives the
# game socket a host and port of its own. Advertising only; nothing listens on
# these, and each defaults to the bound value above.
# ODS_PUBLIC_PORT=8080
# ODS_PUBLIC_SOCKET_PORT=7198
# ODS_PUBLIC_SOCKET_HOST=192.168.1.10

# Behind an https proxy: the address players are given, in place of
# ODS_PUBLIC_HOST and ODS_PUBLIC_PORT. With https the game socket is advertised
# on the same port, because the browser's wss:// has to go through the proxy.
# See "HTTPS" in docs/operations.md.
# ODS_PUBLIC_URL=https://play.example.net

# The proxies whose X-Forwarded-For is believed, as addresses or ranges. Without
# this every player behind a proxy is the proxy's address and shares its limits.
# ODS_TRUSTED_PROXIES=127.0.0.1,::1

# Two limits counted per source address: requests to the web service in ten
# seconds, and game sockets open at once. Behind a proxy named in
# ODS_TRUSTED_PROXIES each player has their own. Behind a tunnel that does not
# say who it is passing on, every player arrives from one address and shares
# them, so raise both there.
# ODS_HTTP_RATE_LIMIT=320
# ODS_MAX_SOCKET_CONNECTIONS_PER_IP=64

# Signs every player's validation token. Left unset, the server writes one to
# data/token-secret on its first run and reads it back afterwards, which is the
# right answer for a single machine — set this only when more than one server
# has to accept the same tokens. Replacing it signs everybody out.
#   openssl rand -hex 32
# ODS_TOKEN_SECRET=

# The shared secret for the internal API the website calls. This is *not* the
# token secret above, which signs player tokens and never leaves this process —
# it is the one value both sides present to each other, and it must be
# identical to the website's ODW_GAME_INTERNAL_TOKEN or every call it makes
# comes back 401. Unset, the internal API does not listen at all.
#   openssl rand -hex 32
# ODS_INTERNAL_TOKEN=
# ODS_INTERNAL_HOST=127.0.0.1
# ODS_INTERNAL_PORT=8081
# Keep disabled unless this port is confined to a trusted private network.
# ODS_ALLOW_INSECURE_INTERNAL=0

# Health and status for whoever is watching the server: /healthz, /livez,
# /status and /players, on a listener of their own. Loopback by default, with
# no credential; 0 turns it off. To watch from another machine, move it and
# give it a token of its own — read-only, and never the internal token above.
#   openssl rand -hex 32
# ODS_STATUS_HOST=127.0.0.1
# ODS_STATUS_PORT=8082
# ODS_STATUS_TOKEN=

# Set 0 to accept whatever account id a client claims, which is only reasonable
# where nobody else can reach the machine.
# ODS_AUTH=1

# Where accounts live. `file` writes one JSON document per account under
# ODS_DATA_DIR; `postgres` needs the schema in db/ and `npm run db:up`.
# ODS_STORAGE=file
# ODS_DATA_DIR=data
# ODS_DATABASE_URL=postgres://ods:ods@127.0.0.1:5432/open_dungeon

# What `npm run db:up` creates, read from the shell rather than from this file.
# Change the password here and in ODS_DATABASE_URL together.
# ODS_DB_USER=ods
# ODS_DB_PASSWORD=ods
# ODS_DB_NAME=open_dungeon
# ODS_DB_PORT=5432

# Where the imported compatibility data is, if not local-data/Resources. Used
# by the server and by `npm run sync:data` alike.
# ODS_RESOURCES_DIR=local-data/Resources

# Whether the server brings the database up to date at startup. db/schema.sql
# only ever adds and every statement is guarded, so this is safe and
# idempotent — set 0 where the application's database user should hold no DDL
# rights, and apply the file yourself.
# ODS_MIGRATE=1

# Account ids that start with administrator rank, comma separated.
# ODS_ADMIN_ACCOUNTS=

# The name the server answers commands under, and a switch to refuse dungeon
# entry cleanly while you work on something else.
# ODS_SERVER_NAME=Server
# ODS_DUNGEON=1

# The player market: the share of a sale the market keeps, and how long a new
# listing waits before anybody else can see or buy it.
# ODS_MARKET_TAX_RATE=0.1
# ODS_MARKET_LISTING_DELAY_SECONDS=180

# The market's limits on one account: listings it may have up per hero it
# owns, the most a weapon may be asked for as a multiple of what the shop pays
# for it, and the least that ceiling is ever allowed to be.
# ODS_MARKET_SLOTS_PER_HERO=5
# ODS_MARKET_PRICE_CEILING_MULTIPLE=50
# ODS_MARKET_MIN_CEILING=1000

# Standing still in a dungeon: when the idle marker appears and when the player
# is sent back to town, in milliseconds. Zero turns either off.
# ODS_AFK_WARN_MS=30000
# ODS_AFK_KICK_MS=60000

# How much the server prints: info, warn, error or silent. It writes to
# standard output only; rotation is the supervisor's job (journald, logrotate).
# ODS_LOG_LEVEL=info

# Records this server's own traffic in the client's format, one file per
# session and never trimmed — a diagnostic aid, not a log directory. Unset
# records nothing, which is the default because a recording holds account
# tokens and half an hour of play is over twenty megabytes.
# ODS_CAPTURE_DIR=logs/captures

# Threads that run whole dungeons, so the game uses more than one core. 0 runs
# everything in one thread (the default); `auto` picks up to four. See
# "Match workers" in docs/operations.md before turning it on.
# ODS_MATCH_WORKERS=0
# ODS_MATCH_WORKER_HANG_MS=5000

# Optional server-side combat observations. `audit` records cast matching,
# CombatResult.when timing and choreography playSpeed disagreements without
# rejecting gameplay; `enforce` currently enforces cast matching while the two
# newer timing checks remain observation-only.
# ODS_CAST_MODE=audit

# Gems paid with a boss trophy, the first time that boss is beaten.
# ODS_TROPHY_GEMS=25

# The Infinite dungeon floors that pay a hero its trophy (once, ever) and its
# gems (once a week). 0 uses the floor the game's own table names.
# ODS_INFINITE_TROPHY_FLOOR=16
# ODS_INFINITE_GEM_FLOOR=25

# The daily login reward: gems for the first, second and third day of a streak
# (multiplied by the heroes on the account; always three amounts), and what
# spinning the boxes again costs in gems.
# ODS_DAILY_REWARD_TIERS=5,10,15
# ODS_DAILY_REPLAY_COST=5

# Hours before the same friend can be sent another gift.
# ODS_GIFT_COOLDOWN_HOURS=24

# The global chat channel: how many lines one account may say at once, and the
# seconds each further line takes to come back.
# ODS_GLOBAL_CHAT_BURST=3
# ODS_GLOBAL_CHAT_LINE_SECONDS=2

# The share of its health and Mana a hero stands back up with from a Health
# Bomb, between 0 and 1.
# ODS_HEALTH_BOMB_REVIVE_SHARE=0.4

# When food on the floor is picked up. A piece is taken once the hero is missing
# at least this share of what it offers; a piece no larger than the scrap share
# of the bar is taken whenever anything at all is missing. Both between 0 and 1.
# ODS_PICKUP_USABLE_SHARE=0.5
# ODS_PICKUP_SCRAP_SHARE=0.25

# How often a running dungeon writes the accounts that gained gold or
# experience, in seconds. They are always written when a floor or the run ends
# and when a player leaves or is dropped; this bounds what a crash can lose.
# 0 turns the clock off.
# ODS_RUN_CHECKPOINT_SECONDS=30

# A hit claimed from further than its attack reaches is refused. Only the hit
# is dropped; nobody is disconnected for it. `audit` reports and lets the hit
# through, `off` does neither.
# ODS_REACH_MODE=enforce
